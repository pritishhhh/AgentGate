# Ollama is local and needs no API key. For Docker, use http://host.docker.internal:11434.
AGENTGATE_DATA_DIR=./data
AGENTGATE_PROVIDER=ollama
AGENTGATE_MODEL=qwen3:1.7b
AGENTGATE_MODEL_URL=http://127.0.0.1:11434
# Optional OpenAI-compatible chat endpoint. Set provider=compatible to enable.
# AGENTGATE_MODEL_URL=https://your-provider.example/v1
# AGENTGATE_MODEL_KEY=replace-locally
AGENTGATE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AGENTGATE_REQUESTS_PER_MINUTE=120

